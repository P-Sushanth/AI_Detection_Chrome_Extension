{
  "manifest_version": 3,
  "name": "AI Content Detector for Search",
  "version": "1.0.0",
  "description": "Instantly displays estimated AI-generated content percentages beside search result links on Google, Bing, and DuckDuckGo.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://*.google.com/*",
        "https://www.bing.com/*",
        "https://duckduckgo.com/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
